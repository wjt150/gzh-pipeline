# 登录态与运行缓存（含 cookie、二维码截图，绝不能传）
.cache/

# 构建产物（可随时重建）
dist/
__pycache__/
*.pyc
*.pyo

# 内部工作日志（运营细节，不适合公开）
.workbuddy/memory/

# 稿件里的第三方原文全文（版权不是我们的）
稿件/*/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.md
稿件/*/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.manifest.json

# 本地环境
.env
*.local
Thumbs.db
.DS_Store

# 备份
*.bak-*
*.zip

# 自己的号名（用 品牌示例.json 复制一份改名）
品牌.json

# ── 状态数据不进 git ──
# 原因：切分支会把这些文件一起切回去。台账一旦回退，闸门会以为「今天没发过」，
# 同一天可能发两篇。数据只存在于工作目录，备份用 python scripts/gzh_export.py。
稿件/
运行台账/
预览/
雷达/pool.jsonl
雷达/pool.jsonl.bak-*
